# MyAtelier Pro - Production Environment Variables
# COPY THIS FILE TO .env AND FILL IN THE SECRETS

# Core App Settings
APP_ENV=production
APP_DEBUG=false
APP_NAME="MyAtelier Pro"
# Use a 32+ character random string
APP_SECRET_KEY=generate-a-very-long-random-string-here-32-chars-plus

# Domain & Origins
# DO NOT USE localhost IN PRODUCTION
APP_FRONTEND_ORIGIN=https://app.yourdomain.com
APP_FRONTEND_ORIGINS=https://app.yourdomain.com
ALLOWED_HOSTS=app.yourdomain.com,api.yourdomain.com,backend

# Database Configuration
# DO NOT USE SQLite IN PRODUCTION
POSTGRES_DB=myatelier_pro
POSTGRES_USER=beauty_admin
POSTGRES_PASSWORD=generate-a-strong-db-password-here
DATABASE_URL=postgresql+psycopg://beauty_admin:your-strong-db-password@db:5432/myatelier_pro

# Storage Configuration
BACKUP_STORAGE_DIR=/app/storage/backups
ATTACHMENT_STORAGE_DIR=/app/storage/attachments

# Redis (For Rate Limiting & Sessions)
REDIS_URL=redis://:your-super-strong-redis-password-here-2026@redis:6379/0
REDIS_PASSWORD=your-super-strong-redis-password-here-2026

# Identity & Access
# Change these before first run
DEFAULT_ADMIN_USERNAME=superadmin
DEFAULT_ADMIN_PASSWORD=change-this-to-something-secure-123

# Security & Sessions
SESSION_COOKIE_NAME=myatelier_pro_session
SESSION_SAME_SITE=lax
SESSION_HTTPS_ONLY=true
SESSION_MAX_AGE_SECONDS=43200

# Operations & Webhooks (Optional)
OPS_BACKUP_STALE_THRESHOLD_HOURS=30
OPS_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...
NIGHTLY_FAILURE_INGEST_TOKEN=generate-a-secure-token
EXPORT_DELIVERY_WEBHOOK_URL=https://your-webhook-endpoint.com
